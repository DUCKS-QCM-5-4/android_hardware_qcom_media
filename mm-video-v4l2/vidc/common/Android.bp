cc_library_static {
    name: "libOmxVidcCommon",
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,

    srcs: [
        "src/vidc_common.cpp",
        "src/vidc_debug.cpp",
        "src/vidc_vendor_extensions.cpp"
    ],

    cflags: [
        "-Werror",
        "-D_ANDROID_",
        "-D_ANDROID_ICS_",
        "-DUSE_ION",
    ] + select(soong_config_variable("ANDROID", "target_board_platform"), {
        "msmnile": [
        "-DVIDC_MSMNILE_HEADER",
        ],
        default: [],
    }),

    header_libs: [
        "display_headers",
        "libomxcommon_headers",
        "libomxcore_headers",
        "libutils_headers",
        "media_plugin_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],
}

cc_library_headers {
    name: "libomxcommon_headers",
    export_include_dirs: ["inc"],
    vendor: true,
}
